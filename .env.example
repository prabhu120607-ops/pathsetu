# =============================================================================
# PathSetu Environment Variables Configuration Template
# Copy this file to .env and configure your Supabase project keys.
# Note: PathSetu includes a complete local fallback layer so the app runs
# fully functional out of the box even before configuring these keys!
# =============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Safe for frontend exposure via RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: MapLibre / Custom Tile Provider URL (Default: OpenStreetMap via Leaflet)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
